---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { comparisonRows } from '../data/site';
---

<section class="comparison-section section-pad section-rule" aria-labelledby="comparison-title">
  <div class="compare-content shell">
    <div class="compare-intro">
      <SectionHeading title="Du prêt à la preuve de retour" id="comparison-title" />
      <p>Le parcours produit visé relie l’accès, la restitution et le contrôle de l’équipement.</p>
    </div>
    <div class="compare-scroll" tabindex="0" role="region" aria-label="Comparaison des approches de stockage">
      <table class="compare-table">
        <caption class="sr-only">Parcours cible LENDRR et pratiques de suivi manuel</caption>
        <thead><tr><th scope="col">Étape</th><th scope="col">Parcours LENDRR visé</th><th scope="col">Suivi manuel courant</th></tr></thead>
        <tbody>{comparisonRows.map(([criterion, lendrr, traditional]) => <tr><th scope="row">{criterion}</th><td>{lendrr}</td><td>{traditional}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="compare-note">Fonctionnement cible du projet, à valider en pilote. L’analyse porte sur l’équipement, jamais sur les personnes.</p>
  </div>
  <aside class="compare-aside shell">
    <div class="compare-aside-inner">
      <Icon name="cube" size={34} />
      <p>Des outils mieux gérés,<br />pour des projets qui avancent<span>.</span></p>
      <i aria-hidden="true"></i>
    </div>
  </aside>
</section>

<style>
  .comparison-section { padding-bottom: var(--section-pad-y); }
  .compare-content { display: grid; grid-template-columns: minmax(15rem,.72fr) minmax(0,1.55fr); column-gap: clamp(2rem,5vw,5rem); row-gap: clamp(1.25rem,2.5vw,2rem); align-items: center; padding-bottom: clamp(2rem,4vw,4rem); }
  .compare-intro { align-self: start; }
  .compare-intro :global(.section-title) { max-width: 13ch; font-size: clamp(2rem,3.3vw,3.6rem); line-height: .98; letter-spacing: -.015em; }
  .compare-intro :global(.section-heading)::after { margin-top: 1rem; }
  .compare-intro p { max-width: 31ch; margin: 1.25rem 0 0; color: var(--color-text-muted); font-size: clamp(.95rem,1.1vw,1.1rem); line-height: 1.55; }
  .compare-scroll { min-width: 0; max-width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; border: 1px solid var(--color-line); border-radius: .65rem; background: color-mix(in srgb, var(--color-surface) 70%, transparent); }
  .compare-table { width: 100%; border-collapse: collapse; font-size: clamp(.78rem,.9vw,.95rem); line-height: 1.45; }
  .compare-table thead { color: var(--color-ink); background: #e6e7e4; }
  .compare-table th,.compare-table td { padding: clamp(.8rem,1.15vw,1.15rem) clamp(.75rem,1.5vw,1.5rem); text-align: left; vertical-align: top; }
  .compare-table thead th { font-family: var(--font-condensed); font-size: .78rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .compare-table tbody tr + tr { border-top: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent); }
  .compare-table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--color-surface-muted) 66%, transparent); }
  .compare-table tbody th { width: 23%; font-weight: 650; }
  .compare-note { grid-column: 1 / -1; margin: 0; color: var(--color-text-muted); font-size: .78rem; line-height: 1.5; }
  .compare-aside { color: var(--color-paper); background: var(--color-ink-deep); }
  .compare-aside-inner { min-height: 150px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: .65rem; padding: clamp(1rem,2vw,2rem); }
  .compare-aside-inner :global(svg) { width: 28px; height: 28px; }
  .compare-aside p { margin: 0; font-family: var(--font-condensed); font-size: clamp(1.15rem,1.8vw,1.8rem); font-weight: 700; letter-spacing: .06em; line-height: 1.05; text-transform: uppercase; }
  .compare-aside p span { color: var(--color-signal); }
  .compare-aside i { width: 2rem; height: 3px; background: var(--color-signal); }
  @media (max-width: 767px) {
    .comparison-section { padding-bottom: var(--section-pad-y); }
    .compare-content { grid-template-columns: 1fr; row-gap: 1.25rem; padding-bottom: 1.75rem; }
    .compare-intro :global(.section-title) { max-width: 16ch; font-size: clamp(2rem,9vw,3rem); }
    .compare-intro p { max-width: 38ch; margin-top: .85rem; }
    .compare-table { min-width: 560px; font-size: .84rem; }
    .compare-table th,.compare-table td { padding: .75rem .8rem; }
    .compare-note { font-size: .74rem; }
    .compare-aside-inner { min-height: 145px; }
    .compare-aside-inner :global(svg) { width: 28px; height: 28px; }
    .compare-aside p { font-size: 1.2rem; }
  }
</style>
