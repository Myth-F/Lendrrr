---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'cube' && <path d="m16 3 12 7v12l-12 7-12-7V10l12-7Z M4 10l12 7 12-7 M16 17v12" />}
  {name === 'shield' && <><path d="M16 3 27 7v8c0 7-4 11-11 14C9 26 5 22 5 15V7l11-4Z" /><path d="m11 16 3 3 7-8" /></>}
  {name === 'bars' && <><path d="M5 27h22" /><path d="M8 25V17h4v8 M15 25V10h4v15 M22 25V5h4v20" /></>}
  {name === 'strength' && <><path d="M8 27c-3-2-4-6-3-9l3-7c1-2 3-2 4 0l1 3 3-6c1-2 4-1 4 1v5l3-2c2-1 4 1 3 3l-3 10c-1 2-3 3-6 3H8Z" /><path d="M9 22h9" /></>}
  {name === 'drill' && <><path d="m8 5 16 3-2 10-15-3L8 5Z M21 12l7 1-1 4-7-1 M11 16l-1 8 4 3 3-9 M7 24h8" /><path d="m12 8 8 2" /></>}
  {name === 'helmet' && <><path d="M4 20a12 12 0 0 1 24 0v3H4v-3Z M16 8v7 M10 10l2 6 M22 10l-2 6 M3 24h26" /></>}
  {name === 'shared' && <><circle cx="11" cy="11" r="4" /><circle cx="22" cy="12" r="3" /><path d="M3 26c0-5 3-8 8-8s8 3 8 8 M19 19c5-2 10 1 10 6" /></>}
  {name === 'box' && <><path d="m16 3 12 7v12l-12 7-12-7V10l12-7Z M4 10l12 7 12-7 M16 17v12" /></>}
  {name === 'phone' && <><rect x="8" y="3" width="16" height="26" rx="2" /><path d="M13 7h6 M14 24h4" /></>}
  {name === 'bell' && <><path d="M7 22h18l-2-3v-6a7 7 0 0 0-14 0v6l-2 3Z M13 26a3 3 0 0 0 6 0" /></>}
  {name === 'settings' && <><circle cx="16" cy="16" r="4" /><path d="M16 3v3 M16 26v3 M3 16h3 M26 16h3 M7 7l2 2 M23 23l2 2 M25 7l-2 2 M9 23l-2 2 M12 4l-1 4 M21 24l-1-4 M28 12l-4 1 M8 19l-4 1" /></>}
  {name === 'arrow' && <><path d="M4 16h22 M18 7l9 9-9 9" /></>}
  {name === 'play' && <><circle cx="16" cy="16" r="13" /><path d="m13 10 8 6-8 6V10Z" fill="currentColor" stroke="none" /></>}
  {name === 'check' && <><circle cx="16" cy="16" r="13" /><path d="m9 16 5 5 9-11" /></>}
</svg>
