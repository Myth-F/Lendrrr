---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LENDRR — La preuve de l’état des équipements au retour',
  description = 'Le casier connecté LENDRR associe les emprunts à leurs utilisateurs et documente la présence et l’état du matériel à la restitution.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171b1d" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="/" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu principal</a>
    <slot />
  </body>
</html>
