---
import BrandMark from './BrandMark.astro';
import { navigation, siteContent } from '../data/site';
const home = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="site-footer">
  <div class="footer-top shell">
    <BrandMark />
    <span class="footer-line" aria-hidden="true"></span>
    <p>{siteContent.brandLine}</p>
    <nav aria-label="Navigation de pied de page">
      {navigation.slice(0, 4).map((link) => <a href={link.href.startsWith("#") ? home + link.href : link.href}>{link.label}</a>)}
    </nav>
    <a class="footer-word" href="#top">LENDRR.COM</a>
  </div>
  <div class="footer-bottom shell">
    <p id="a-propos" tabindex="-1">{siteContent.about}</p>
    <p id="ressources" tabindex="-1">Parcours produit visé · caractéristiques du modèle 3D à confirmer sur site</p>
  </div>
</footer>

<style>
  .site-footer { color: var(--color-paper); background: var(--color-ink-deep); }
  .footer-top { min-height: 66px; display: grid; grid-template-columns: 154px minmax(36px, 1fr) minmax(160px, 1.1fr) auto auto; align-items: center; gap: 1rem; }
  .footer-top :global(.brand) { width: 135px; }
  .footer-line { height: 1px; background: rgb(243 241 234 / 45%); }
  .footer-top p { margin: 0; font-family: var(--font-condensed); font-size: .65rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .footer-top nav { display: flex; gap: 1rem; }
  .footer-top nav a,.footer-word { font-size: .67rem; font-weight: 600; text-decoration: none; }
  .footer-word { letter-spacing: .12em; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: .75rem 1rem; border-top: 1px solid rgb(243 241 234 / 18%); }
  .footer-bottom p { margin: 0; color: rgb(243 241 234 / 75%); font-size: .69rem; }
  @media (max-width: 820px) {
    .footer-top { min-height: 0; grid-template-columns: auto 1fr auto; gap: .8rem; padding-block: 1rem; }
    .footer-top .footer-line { display: none; }
    .footer-top p { max-width: 20ch; }
    .footer-top nav { grid-column: 1 / -1; grid-row: 2; flex-wrap: wrap; gap: .75rem 1rem; }
  }
  @media (max-width: 560px) {
    .footer-top { grid-template-columns: 1fr auto; }
    .footer-top p { grid-column: 1 / -1; grid-row: 2; }
    .footer-top nav { grid-row: 3; }
    .footer-bottom { flex-direction: column; }
  }
</style>
