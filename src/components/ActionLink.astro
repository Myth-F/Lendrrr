---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'dark';
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = true, class: className } = Astro.props;
---

<a class:list={['action-link', `action-link--${variant}`, className]} href={href}>
  <slot />
  {arrow && <Icon name="arrow" size={18} class="action-arrow" />}
</a>

<style>
  .action-link {
    display: inline-flex;
    min-height: var(--control-min-height);
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.55rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .action-link--primary { color: var(--color-on-signal); background: var(--color-signal); }
  .action-link--primary:hover { background: var(--color-signal-hover); }
  .action-link--secondary { color: var(--color-ink); border-color: var(--color-ink); background: transparent; }
  .action-link--secondary:hover { background: rgb(32 35 38 / 7%); }
  .action-link--dark { color: var(--color-paper); border-color: var(--color-paper); background: transparent; }
  .action-link--dark:hover { color: var(--color-ink); background: var(--color-paper); }
  .action-arrow { flex: 0 0 auto; transition: transform var(--duration-fast) var(--ease-out); }
  .action-link:hover .action-arrow { transform: translateX(2px); }
  @media (prefers-reduced-motion: reduce) { .action-link, .action-arrow { transition: none; } }
  @media (max-width: 767px) { .action-link { width: 100%; } }
</style>
