  .back { display: inline-block; margin-bottom: 3rem; font-size: .85rem; text-underline-offset: .3em; }
  article { max-width: 1050px; margin-inline: auto; }
  .eyebrow { color: var(--color-text-muted); }
  h1 { max-width: 19ch; margin: 1rem 0 1.5rem; font-family: var(--font-heading); font-size: clamp(2.5rem,5vw,5rem); letter-spacing: -.055em; line-height: 1.02; }
  .lead { max-width: 58ch; font-size: clamp(1.1rem,1.8vw,1.45rem); line-height: 1.55; }
  .article-body { max-width: 72ch; margin-top: 3rem; font-size: 1rem; line-height: 1.8; }
  h2 { margin: 2.5rem 0 .75rem; font-family: var(--font-heading); font-size: clamp(1.45rem,2.5vw,2rem); line-height: 1.2; letter-spacing: -.03em; }
  .press-cta { display: inline-flex; align-items: center; gap: 1rem; margin-top: 1.5rem; padding: 1rem 1.25rem; background: var(--color-signal); color: var(--color-ink); font-weight: 650; text-decoration: none; }
  .sources { max-width: 72ch; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); font-size: .8rem; color: var(--color-text-muted); }
  .sources ul { padding-left: 1.2rem; }
  .sources li { margin-block: .65rem; }
  @media(max-width: 540px) { .back { margin-bottom: 2rem; } .press-cta { width: 100%; justify-content: space-between; } }
</style>
